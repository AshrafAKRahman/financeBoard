APP_ENV=dev

# Neon pooled endpoint (host contains "-pooler"): API request traffic.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon direct endpoint: migrations, the job worker, and concurrency tests.
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Direct endpoint of the "test" branch. Database tests create and drop their own
# databases on it, and are skipped when this is unset.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-yyy.REGION.aws.neon.tech/neondb?sslmode=require
